#this code asks user to enter name, date and source of the info tehy would like to add to the library

import json
#list of all the records
item_record_collection = []

#metadata structure
#loop to add elements to the list

while True:
    # Collect all the information
      name = input("Please enter the name of the record: ").strip()
      date = input("Please enter the date: ")
      source = input("Please enter the URL to the original page: ")
      description = input("Please enter a short description of the item: ")
     

    # Create the record
      item_record = {
        "name": name,
        "date": date,
        "source": source,
        "description": description,
    }

    # Add the completed record to the collection
      item_record_collection.append(item_record)
      print("Entry added! Thank you :)")

    # loop condition
      loop = input("Add another record? (yes/no): ").strip().lower()

      while loop not in ["yes", "no"]:
        loop = input("Please enter yes or no: ").strip().lower()

      if loop == "no":
        break


#add the entries to the library
item_record_collection.append(item_record)

#now we save the whole collection as a json file named item_records

with open("item_records.json", "w", encoding="utf-8") as file:
  json.dump(item_record_collection, file, indent=4)

