#open file to read it
with open("record_collection_file.json", "r", encoding="utf-8") as file:
    records = json.load(file)


# loop asking for keyword
while True:
    keyword = input(
        "Enter a keyword (or type 'done' to finish): "
    ).strip().lower()

    if keyword == "done":
        print("Search finished.")
        break

    if not keyword:
        print("Please enter a keyword.")
        continue

    # Reset for each new search
    found = False

    for record in records:
        description = record.get("description", "")

        if keyword in description.lower():
            print("Name:", record.get("name", "No name provided"))
            print("URL:", record.get("source", "No URL provided"))
            print()

            found = True

    if not found:
        print("No matching records found.\n")

